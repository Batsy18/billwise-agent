# Cloud overlay for the agent: copy to .env.cloud (gitignored) and fill in.
# Used by `npm run chat:cloud` / `npm run demo:cloud` (or ENV_FILE=.env.cloud).
# Values here win; everything else (GEMINI_API_KEY, SEED_* passwords …) still comes from .env.
# infra/deploy.sh prints the two URLs at the end. Never commit this file.

# All REST traffic goes through GCP API Gateway.
BILLING_API_URL=https://<gateway-host>.ew.gateway.dev
# mcp-server on Cloud Run (public, protected by X-API-Key).
MCP_URL=https://<mcp-server-service>.europe-west1.run.app/mcp
# The cloud key (Secret Manager secret MCP_API_KEY), NOT your local one. Fetch it with:
#   gcloud secrets versions access latest --secret=MCP_API_KEY --project=<project-id>
MCP_API_KEY=

# Only for `npm run demo:cloud -- --reseed`: Cloud SQL through the Auth Proxy on your machine
#   cloud-sql-proxy --gcloud-auth --port 5433 <project>:europe-west1:billwise-pg
# Password: the `billwise` DB user's password (inside the DATABASE_URL secret).
DATABASE_URL=postgresql://billwise:<password>@localhost:5433/billwise
