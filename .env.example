# Copy to .env and adjust. Never commit .env.

# --- Local PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=billwise
POSTGRES_PASSWORD=billwise
POSTGRES_DB=billwise
POSTGRES_PORT=5432

# --- billing-api (Prisma) ---
DATABASE_URL=postgresql://billwise:billwise@127.0.0.1:5432/billwise?schema=public

# Integration tests (npm run test:int) use their own database; the name MUST end in _test.
# It is created and migrated automatically.
DATABASE_URL_TEST=postgresql://billwise:billwise@127.0.0.1:5432/billwise_test?schema=public

# --- billing-api server ---
PORT=3000

# --- JWT (RS256) ---
# Private key as a PEM. Never commit it. Generate one for local dev with:
#   npm run keys:generate -w @billwise/billing-api        (writes it into .env; --force to replace)
# The public key is derived from it and published at GET /.well-known/jwks.json.
# In the cloud this comes from Secret Manager (Phase 4).
JWT_PRIVATE_KEY=
JWT_ISSUER=billwise-billing-api
JWT_AUDIENCE=billwise-api
JWT_TTL_SECONDS=3600

# --- mcp-server (Streamable HTTP at POST /mcp; stdio needs none of this) ---
MCP_PORT=3001
# Clients send it as the X-API-Key header. At least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_API_KEY=
# Used by `npm run call-tool -w @billwise/mcp-server` (and later the agent)
MCP_URL=http://127.0.0.1:3001/mcp

# --- agent (npm run chat / npm run demo) ---
# Billing REST API base URL: billing-api locally, the API Gateway URL in .env.cloud.
# 127.0.0.1 rather than localhost: Node resolves localhost to ::1 first on Windows.
BILLING_API_URL=http://127.0.0.1:3000
# (MCP_URL + MCP_API_KEY above are used too; without MCP_API_KEY the agent uses stdio.)
# gemini | mock (mock = no quota, dev only)
LLM_PROVIDER=gemini
# Google AI Studio API key. Never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# MINIMAL | LOW | MEDIUM | HIGH (Gemini 3.x thinkingLevel) or an integer token budget (2.x).
# gemini-3.5-flash-lite rejects thinkingBudget 0; MINIMAL is its lowest setting.
GEMINI_THINKING_BUDGET=MINIMAL
# Gap between LLM requests — npm run demo only (chat is not paced).
# Free tier of gemini-3.5-flash-lite: 15 RPM → 4100 ms.
LLM_MIN_INTERVAL_MS=4100
# Per Gemini request. On expiry the request is aborted and retried once (like a 503);
# a second timeout ends the turn with a "please try again" message.
GEMINI_TIMEOUT_MS=20000

# --- Seed (demo accounts; fictitious data, local only) ---
# Login for "admin" and for the demo subscribers 5551000001..3
SEED_ADMIN_PASSWORD=admin-demo-pass
SEED_USER_PASSWORD=user-demo-pass
