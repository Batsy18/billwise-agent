# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo
coverage/

# env & secrets
.env
.env.*
!.env.example
!.env.cloud.example
*.pem
*.key

# agent traces (keep curated examples under docs/)
packages/agent/traces/

# local tool state (kept on this machine only)
.remember/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# generated Prisma client (recreated by `prisma generate` / postinstall)
packages/billing-api/src/generated/

# MCP search index (rebuilt by `npm run build-index`, also part of `npm run build`)
packages/mcp-server/generated/

# infra/deploy.sh by-products (rendered gateway configs contain only URLs; proxy log)
infra/gateway/.rendered-*.yaml
infra/.proxy.log
